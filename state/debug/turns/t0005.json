  "proposal": {
    "summary": "You keep sprinting without looking back, trying to outrun the Nest Warden with nothing but the cane in hand.",
    "target": null,
    "minutes": 1,
    "fatigue": 2
  },
  "outcomes": [
    {
      "band": "common",
      "text": "The Warden's lunging bite catches you across the back before you can turn, and the running is over — the fight is on you.",
      "p": 0.35
    },
    {
      "band": "common",
      "text": "You twist at the last instant and take the bite on your raised cane-arm instead, but there's no more road left to run — you're in it now.",
      "p": 0.35
    },
    {
      "band": "uncommon",
      "text": "Your legs give out from under you mid-stride as the Warden closes, and you come up onto one knee with the cane already swinging.",
      "p": 0.18
    },
    {
      "band": "rare",
      "text": "The line of paw-prints beside you pulls suddenly taut, like something on the other end of a leash, and the Warden's lunge hitches half a step before it's on you.",
      "p": 0.08
    },
    {
      "band": "epic",
      "text": "For an instant the prints beside you deepen into something with weight and shoulder, and the Warden's bite closes on the space where you should have been standing.",
      "p": 0.03
    },
    {
      "band": "legendary",
      "text": "You feel, unmistakably, a wet nose shove your leg sideways a half-step before the teeth would have found it, and something that isn't there anymore hauls you clear as the Warden lunges through empty air.",
      "p": 0.01
    }
  ],
